{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "group:allNonMajor",
    "schedule:weekly",
    ":maintainLockFilesWeekly"
  ],
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}
